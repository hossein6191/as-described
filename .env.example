# The deployed AsDescribed contract on GenLayer Studio (chain 61999). Empty → lib/config.ts DEMO_CONTRACT.
# With both empty every read throws "could not reach the network" (pages show the snapshot when they have one).
NEXT_PUBLIC_CONTRACT=

# 1 → the site runs on in-memory mock data (lib/chain-mock.ts): no wallet, no network. For local UI work only.
# The delivery API honours it too, but only when the site is not a deployment (VERCEL unset): chain checks go
# to the mock, and the mock seller/buyer may upload/read without a signature (there is no key for those
# addresses). On a deployment the routes demand a signature and a vetted register whatever this says.
NEXT_PUBLIC_MOCK=0

# Vercel Blob read-write token (Storage → Blob → connect the store to the project). A newer Blob store
# gives the project BLOB_STORE_ID instead and signs the call with the deployment's own OIDC token; either
# shape counts as a bucket (lib/store.ts).
# Empty → packs are files under .data/packs/<register>/<listing>.json (dev; .data/ is git-ignored).
# Set this together with PACK_SECRET below: with a token and no secret the site stores no packs at all.
BLOB_READ_WRITE_TOKEN=

# Any long random string (e.g. `openssl rand -hex 32`). Pack contents are sealed at rest with AES-256-GCM
# under a key derived from it (scrypt, salt "as-described"). Empty → the local .data/ store keeps packs in the
# clear (dev only), and a Blob store is not written to at all, so only the demo packs can be listed.
# Changing it makes every pack stored under the old value unreadable; there is no re-keying.
PACK_SECRET=
